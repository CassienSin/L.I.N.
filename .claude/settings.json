{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.venv-voice/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_edit.py\" pre"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.venv-voice/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_edit.py\" post"}
        ]
      }
    ]
  }
}
